# Service URLs and ports live in ../bridge.env.
# Keep this file for secrets, integration credentials, and bridge behavior.
#
# Optional local overrides are supported, but prefer ../bridge.env for:
#   BRIDGE_PORT, BRIDGE_PUBLIC_URL, LM_STUDIO_URL, LM_MODEL, LM_TIMEOUT_S,
#   WAZUH_API_URL, WAZUH_INDEXER_URL, SIEM_DASHBOARD_URL, MCP_SERVER_URL.

# How many alerts can sit in the in-memory queue before we start
# returning 503 to Wazuh (back-pressure).
QUEUE_MAXSIZE=1000

# Parallel inference slots. Tune to ≤ what your GPU/CPU can sustain
# without thrashing — 1–2 is usually right for a single local model.
WORKER_COUNT=2

# Required when the bridge is reachable from another machine.
# scripts/run.sh refuses to bind the bridge to 0.0.0.0 without this secret,
# unless EDGESEC_ALLOW_UNAUTH_WEBHOOK=1 is explicitly set for a private lab.
WEBHOOK_SECRET=replace-with-a-long-random-secret

# Destructive action API secret. Anyone holding this can trigger manual
# block / unblock / isolation actions, so use a different long random value.
ACTIVE_RESPONSE_TOKEN=replace-with-a-different-long-random-secret

# Slack/LINE deep links for editing endpoint business context expire quickly.
ADMIN_TOKEN_TTL_S=900

# Optional: Slack incoming-webhook URL. When set, every LLM-triaged alert
# is forwarded as a coloured Slack attachment with severity, IOCs, MITRE
# technique and recommended action. Leave blank to disable.
#
# Get one at:  Slack → Apps → "Incoming Webhooks" → Add to Workspace
# Discord users: this also works on Discord — just append "?slack=true" to
# your Discord webhook URL, e.g.
#   SLACK_WEBHOOK_URL=https://discord.com/api/webhooks/.../slack?slack=true
SLACK_WEBHOOK_URL=
SLACK_TIMEOUT_S=10

# ── Phase 2: interactive 🔒 Block buttons via Socket Mode ────────────
# When ALL THREE of the below are set, Slack notifications use bot-mode
# (chat.postMessage with action buttons) instead of incoming webhook.
# Without these, falls back to webhook (no buttons).
#
# Where to get them:
#   1. https://api.slack.com/apps → Create New App → From scratch
#   2. OAuth & Permissions → Scopes → add chat:write
#   3. Socket Mode → enable → generate App-Level Token (scope: connections:write)
#   4. Interactivity & Shortcuts → enable
#   5. Install App → copy Bot User OAuth Token
#   6. /invite @<botname> in the target Slack channel; copy channel ID
SLACK_BOT_TOKEN=          # xoxb-...
SLACK_APP_TOKEN=          # xapp-1-...
SLACK_CHANNEL_ID=         # C0123ABCDEF (channel) or D0123ABC (DM)

# Optional destructive endpoint isolation.
# Wazuh does not provide a universal built-in "isolate endpoint" command.
# To enable Slack's 隔離端點 action, first install and test an
# active-response script on every target agent, register it in the Wazuh
# Manager command list, then set the command name here.
#
# Example after deploying a custom command named edgesec-isolate:
# WAZUH_ISOLATE_COMMAND=edgesec-isolate0
WAZUH_ISOLATE_COMMAND=

# Optional: LINE push notification. These can also be saved from
# /admin/notifications after the bridge is running.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# Optional: Telegram bot notification. These can also be saved from
# /admin/notifications after the bridge is running.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How long Dashboard one-click setup links stay valid.
# Default is 8 hours so a business user can keep the Dashboard open during the day.
PROFILE_LINK_TTL_S=28800

# Optional: Email notification. These can also be saved from
# /admin/notifications after the bridge is running.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SSL=false
SMTP_STARTTLS=true
EMAIL_FROM=
EMAIL_TO=

# SQLite database for alert + LLM-verdict history. Default: data/alerts.db
# (relative to wherever you run uvicorn from). Used by GET /alerts and /stats.
DB_PATH=data/alerts.db

# ── Phase 3a: Wazuh MCP Server integration (LLM enrichment) ───────────
# When configured, every alert with a source IP gets enriched with related
# events from the past 7 days before reaching the LLM, turning the prompt
# from "single alert" to "alert + historical context".
#
# Set up: deploy gensecaihq/Wazuh-MCP-Server alongside Wazuh stack via
#   wazuh-stack/start-mcp-server.sh
# Then copy the MCP_API_KEY value it generated:
MCP_API_KEY=                    # wazuh_<32-byte token> from wazuh-mcp/.env
# Timeouts. Defaults are aggressive so a paused/down MCP server is detected
# quickly (connect=3s) instead of stalling each tool call for the full read
# timeout. When MCP works normally, calls finish in <1s so the 10s read
# timeout is plenty.
MCP_CONNECT_TIMEOUT_S=3
MCP_HTTP_TIMEOUT_S=10

# ── Phase 3b: Agentic deep-investigation loop ──────────────────────────
# When Stage-1 LLM (or admin policy) decides an alert is worth deeper
# investigation, the bridge runs a tool-using loop — letting Gemma call
# Wazuh MCP read tools (search events / list processes / check vulns /
# check ports / check agent health) before reaching a final verdict.
#
# Each pass: model calls 1+ tools → we execute → result fed back →
# model decides next move. Bounded by MAX_ITERATIONS and TIMEOUT_S
# so it can never run away.
AGENTIC_MAX_ITERATIONS=6        # max chat turns before forcing exit (raise verdict)
AGENTIC_TIMEOUT_S=120           # hard wall-clock cap on the whole loop
AGENTIC_TOOL_RESULT_MAX=1500    # truncate each MCP tool result to this many chars
# Tool-call format stability — set to 0.0 (greedy) for max determinism.
# Gemma 4 31B drops out of OpenAI tool-call format ~10% of the time at 0.1;
# at 0.0 it sticks to the format almost always. Stage-1 LLM stays at 0.1
# (independent setting in app.py) — only the agentic loop is affected here.
AGENTIC_TEMPERATURE=0.0

# Triage routing — 3-layer policy (NEVER > FORCE > LLM-decides default).
#
#   Layer 1 (NEVER): always skip agentic; just Stage-1 LLM.
#                    Use to mute known-noisy rules / groups.
#   Layer 2 (FORCE): always run agentic, even if Stage-1 wouldn't escalate.
#                    Use for high-stakes rules you NEVER want auto-dismissed.
#   Layer 3 (default): defer to Stage-1 LLM's needs_investigation flag.
#
# Examples (CSV — empty = no rule matches that layer):
#   AGENTIC_FORCE_RULE_IDS=5712,31103,510,91802
#   AGENTIC_FORCE_GROUPS=attack,intrusion_detection,malware
#   AGENTIC_FORCE_LEVEL_GTE=12          # any alert ≥ level 12 → forced agentic
#   AGENTIC_NEVER_RULE_IDS=19007,19008  # CIS-baseline drift = boring, no LLM tools
#   AGENTIC_NEVER_GROUPS=sca,ossec
AGENTIC_FORCE_RULE_IDS=
AGENTIC_FORCE_GROUPS=
AGENTIC_FORCE_LEVEL_GTE=12
AGENTIC_NEVER_RULE_IDS=
AGENTIC_NEVER_GROUPS=

# Business-context routing — lets critical / PCI / off-hours endpoints go
# straight to MCP agentic investigation even when the raw Wazuh level is lower.
# NEVER rules/groups still win, so SCA baseline checks can stay cheap.
AGENTIC_BUSINESS_CONTEXT=true
AGENTIC_BUSINESS_CRITICALITIES=critical
AGENTIC_BUSINESS_MIN_LEVEL=8
AGENTIC_BUSINESS_OFFHOURS_MIN_LEVEL=6
