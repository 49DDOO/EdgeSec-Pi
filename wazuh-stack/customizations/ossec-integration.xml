  <!--
    EdgeSec-Pi: forward every alert with level >= 7 to the LLM bridge.
    The integrator daemon will invoke the script at /var/ossec/integrations/custom-llm-bridge
    with three positional args: ($1) alert.json path, ($2) api key (unused), ($3) hook_url.
  -->
  <integration>
    <name>custom-llm-bridge</name>
    <hook_url>https://host.docker.internal:{{BRIDGE_PORT}}/webhook</hook_url>
    <!-- Shared secret: must match WEBHOOK_SECRET on the bridge. setup.sh
         replaces this token with the value generated by:
           python3 -c "import secrets; print(secrets.token_urlsafe(32))"
         and set the same value as WEBHOOK_SECRET= in wazuh-llm-bridge/.env -->
    <api_key>{{WEBHOOK_SECRET}}</api_key>
    <level>7</level>
    <alert_format>json</alert_format>
  </integration>
