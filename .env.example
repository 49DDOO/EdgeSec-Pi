# EdgeSec-Pi — optional Wazuh MCP Server environment template
# This file is only for the advanced LobeChat + Wazuh MCP route.
# It is not used by the main Dashboard / notification bridge.
#
# Copy this file to wazuh-mcp/.env (after running install.sh / cloning the repo).
# DO NOT commit the real .env to git.

# ── Wazuh Manager API ────────────────────────────────────────────
WAZUH_HOST=10.0.0.10
WAZUH_PORT=55000
WAZUH_USER=wazuh-wui
WAZUH_PASS=ChangeMe!

# ── Wazuh Indexer (required for alert search & vulnerability tools) ──
WAZUH_INDEXER_HOST=10.0.0.10
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=ChangeMe!

# ── MCP Server ───────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=3000
AUTH_MODE=bearer
# Generate with:  python3 -c "import secrets; print('wazuh_'+secrets.token_urlsafe(32))"
MCP_API_KEY=wazuh_REPLACE_ME

# CORS — comma-separated list of LobeChat origins that may call /mcp
ALLOWED_ORIGINS=http://localhost:3210

# Self-signed Wazuh certs in lab? set to false. In prod, true.
VERIFY_SSL=false

# ── Optional: Redis for multi-instance session sharing ──────────
# REDIS_URL=redis://redis:6379/0
