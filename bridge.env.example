# EdgeSec-Pi service location defaults.
# Copy to bridge.env and adjust for your machine.
#
# Keep non-secret ports and service URLs here so deployment topology is easy
# to review. Secrets still belong in wazuh-llm-bridge/.env or the relevant
# component .env file.
#
# bridge.env is intentionally gitignored because local URLs and deployment
# choices vary by machine.

# ── EdgeSec-Pi bridge / dashboard ───────────────────────────────────
BRIDGE_PORT=8001
BRIDGE_PUBLIC_URL=https://localhost:8001
# Use 0.0.0.0 when Wazuh runs in Docker or another machine must reach the
# bridge. scripts/run.sh then requires WEBHOOK_SECRET in wazuh-llm-bridge/.env.
BRIDGE_BIND_HOST=0.0.0.0
# Serve the bridge/dashboard over HTTPS.
# Paths are resolved from wazuh-llm-bridge/ when running uvicorn there.
BRIDGE_SSL_CERTFILE=../scripts/certs/bridge.crt
BRIDGE_SSL_KEYFILE=../scripts/certs/bridge.key

# ── Local LLM endpoint ──────────────────────────────────────────────
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions
# Optional override. If unset, scripts derive it from LM_STUDIO_URL.
# LM_STUDIO_MODELS_URL=http://localhost:1234/v1/models
LM_MODEL=local-model
LM_TIMEOUT_S=180

# ── Wazuh lab / existing Wazuh endpoints ────────────────────────────
# The bridge uses WAZUH_API_URL for Active Response and agent lookups.
WAZUH_API_URL=https://localhost:55000

# Optional browser deep-link base URL for Wazuh Dashboard or another SIEM UI.
# If empty, the management dashboard shows "SIEM 深查（尚未設定）" instead
# of a broken local link.
SIEM_DASHBOARD_URL=

# replay_sample_alerts.py and MCP-related tooling use this when querying
# indexed alerts directly.
WAZUH_INDEXER_URL=https://localhost:9200

# Native agent enrollment target for scripts/install-mac-agent.sh.
MANAGER_HOST=localhost
WAZUH_AGENT_PORT=1514
WAZUH_AUTHD_PORT=1515

# ── Optional Wazuh MCP Server ───────────────────────────────────────
# MCP_HOST_PORT is the host port exposed by wazuh-stack/wazuh-mcp.
MCP_HOST_PORT=3030
MCP_SERVER_URL=http://localhost:3030

# ── Optional LobeChat / MCP UI route ────────────────────────────────
LOBECHAT_URL=http://localhost:3210
